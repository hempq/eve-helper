[Unit]
Description=EVE Helper (standalone Docker Compose stack, auto-start on boot)
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
# Runs as root so it can (re)add the hostname on every boot — WSL regenerates
# /etc/hosts on start when generateHosts is on. Docker runs fine as root.
ExecStartPre=/bin/sh -c "grep -q eve-helper.local /etc/hosts || echo '127.0.0.1  eve-helper.local' >> /etc/hosts"
ExecStart=/usr/bin/docker compose -f /home/hempq/apps/eve-helper/deploy/docker-compose.yml up -d
ExecStop=/usr/bin/docker compose -f /home/hempq/apps/eve-helper/deploy/docker-compose.yml stop
TimeoutStartSec=300

[Install]
WantedBy=multi-user.target
