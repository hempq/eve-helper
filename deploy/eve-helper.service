[Unit]
Description=EVE Helper (standalone Docker Compose stack, auto-start on boot)
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
User=hempq
Group=hempq
WorkingDirectory=/home/hempq/apps/eve-helper/deploy
# Independent of DDEV: `ddev poweroff` never touches this compose project.
ExecStart=/usr/bin/docker compose -f /home/hempq/apps/eve-helper/deploy/docker-compose.yml up -d
ExecStop=/usr/bin/docker compose -f /home/hempq/apps/eve-helper/deploy/docker-compose.yml stop
TimeoutStartSec=300

[Install]
WantedBy=multi-user.target
