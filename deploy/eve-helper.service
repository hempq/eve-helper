[Unit]
Description=EVE Helper (DDEV project, auto-start on boot)
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
User=hempq
Group=hempq
WorkingDirectory=/home/hempq/apps/eve-helper
# Login shell so DDEV finds mkcert/CAROOT and the user's PATH.
ExecStart=/bin/bash -lc 'ddev start -y'
ExecStop=/bin/bash -lc 'ddev stop'
TimeoutStartSec=300

[Install]
WantedBy=multi-user.target
